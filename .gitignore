# ─────────────────────────────────────────────
# macOS / IDE
# ─────────────────────────────────────────────
.DS_Store
.claude/
.idea/
.vscode/

# ─────────────────────────────────────────────
# Build artifacts
# ─────────────────────────────────────────────
bin/
build/
cmake-build/
cmake-build-debug/
cmake-build*/
ResultAnalysis/

*.o
*.a
*.so
*.dylib

# CMake generated
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
install_manifest.txt

# Do NOT ignore project Makefile by default.
# If you generate local Makefiles from CMake, they are already inside build dirs.

# ─────────────────────────────────────────────
# Python
# ─────────────────────────────────────────────
__pycache__/
*.pyc
.venv/
venv/
experiments/*.venv/

# ─────────────────────────────────────────────
# Logs / backups
# ─────────────────────────────────────────────
*.log
*.bak

# ─────────────────────────────────────────────
# Local/generated outputs
# ─────────────────────────────────────────────
results/
audio/

files/matrices/
files/outputs/
files/*.html
files/*.csv

# Ignore local input files if they are generated/private.
# Remove this line if you want to commit small sample inputs.
files/inputs/

# ─────────────────────────────────────────────
# Large data / matrices
# ─────────────────────────────────────────────
*.npy
*.npz
dataset/

# ─────────────────────────────────────────────
# Experiments
# ─────────────────────────────────────────────

# Ignore everything in experiments by default.
experiments/*

# Keep only experiment scripts for now.
!experiments/scripts/
!experiments/scripts/**
experiments/scripts/__pycache__/

# These older experiment folders look local/generated.
# Remove these two lines later if you want to version cleaned scripts/configs from them.
archived_experiments/

tmp/
dataset/OSM_DATA/*.pbf
